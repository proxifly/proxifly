{
  "name": "proxifly",
  "version": "3.0.1",
  "description": "Proxifly is a service to get free HTTPS proxies and check your public IP",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "scripts": {
    "start": "npm run prepare:watch",
    "build": "node -e \"require('prepare-package')()\"",
    "prepare": "node -e \"require('prepare-package')()\"",
    "test": "npm run build && mocha test/ --recursive --timeout=10000",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "preparePackage": {
    "input": "src",
    "output": "dist",
    "type": "bundle",
    "build": {
      "formats": [
        "esm",
        "cjs",
        "iife"
      ],
      "iife": {
        "globalName": "Proxifly",
        "fileName": "proxifly.min.js"
      }
    },
    "replace": {}
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proxifly/proxifly"
  },
  "keywords": [
    "proxifly",
    "proxy api",
    "proxy list api",
    "proxies",
    "free proxies",
    "http proxies",
    "https proxies",
    "socks proxies",
    "proxy list",
    "ip",
    "ipv4",
    "ipv6",
    "get public ip"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/proxifly/proxifly/issues"
  },
  "homepage": "https://proxifly.dev",
  "dependencies": {
    "itwcw-package-analytics": "^1.0.8",
    "wonderful-fetch": "^2.0.4"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "prepare-package": "^2.0.7"
  }
}
